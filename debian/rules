#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Avoid blhc complaining
export DEB_CFLAGS_MAINT_APPEND = -D_FORTIFY_SOURCE=2

LIBDIR=usr/lib/$(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

%:
	dh $@

# tests/common/Makefile isn't parallel safe in Ubuntu 24.04 LTS
# https://github.com/mer-hybris/libgbinder/issues/172
override_dh_auto_clean:
	dh_auto_clean --no-parallel

override_dh_auto_test:
	dh_auto_test --no-parallel

override_dh_auto_build:
	dh_auto_build -- STRIP=true
	dh_auto_build --sourcedirectory=tools --no-parallel -- KEEP_SYMBOLS=1

override_dh_auto_install:
	dh_auto_install -- LIBDIR=$(LIBDIR) install-dev
	dh_auto_install --sourcedirectory=tools --no-parallel
